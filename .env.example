# Copy this file to .env and paste your real key in.
#   cp .env.example .env
#
# .env is gitignored - it must never be committed. This example file is safe
# to commit precisely because it holds no real key.
#
# Get a free key at https://aistudio.google.com/apikey (no credit card).
# New keys look like AQ.Ab... ; older ones look like AIza... . Both work.
GEMINI_API_KEY=paste-your-key-here
